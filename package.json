{
  "name": "@mirafive/tanstack",
  "version": "2.0.1",
  "description": "MIRA FIVE for TanStack Start and Router: a React provider and hooks for the browser, and request middleware that gives server functions a client on context.mira.",
  "keywords": [
    "analytics",
    "attribution",
    "mira-five",
    "mirafive",
    "react",
    "tanstack",
    "tanstack-router",
    "tanstack-start"
  ],
  "homepage": "https://github.com/mirafive/sdk-tanstack#readme",
  "bugs": {
    "url": "https://github.com/mirafive/sdk-tanstack/issues"
  },
  "license": "MIT",
  "author": "Cloo GmbH <hallo@mirafive.io> (https://mirafive.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-tanstack.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./start": {
      "types": "./dist/start.d.ts",
      "default": "./dist/start.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@mirafive/node": "^2.2.1",
    "@mirafive/react": "^2.0.1"
  },
  "devDependencies": {
    "@tanstack/react-start": "^1.169.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.120",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.4"
}
