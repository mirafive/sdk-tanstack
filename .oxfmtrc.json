{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "printWidth": 110,
  "trailingComma": "none",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "dist/**",
    "test/fixtures/**",
    "bun.lock",
    "**/*.md",
    "examples/.packs/**",
    "examples/*/src/routeTree.gen.ts",
    "examples/*/next-env.d.ts",
    "examples/*/.next/**",
    "examples/*/dist/**"
  ]
}
